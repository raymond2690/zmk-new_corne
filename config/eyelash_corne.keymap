#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        HR_Shift: HR_Shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HR_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "tap-preferred";
        };

        HR_other: HR_other {
            compatible = "zmk,behavior-hold-tap";
            label = "HR_OTHER";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <170>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };

        Backspace {
            bindings = <&none>;
            key-positions = <25 26>;
            layers = <0 7 7>;
        };

        Delete {
            bindings = <&none>;
            key-positions = <26 27>;
            layers = <0 7 7>;
        };

        Op_Parentheses {
            bindings = <&none>;
            key-positions = <36 37>;
            layers = <0 7 7>;
        };

        Cl_Parentheses {
            bindings = <&none>;
            key-positions = <37 38>;
            layers = <0 7 7>;
        };

        Op_Sq_Brackets {
            bindings = <&none>;
            key-positions = <38 39>;
            layers = <0 7 7>;
        };

        Cl_Sq_Brackets {
            bindings = <&none>;
            key-positions = <39 40>;
            layers = <0 7 7>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESC  &kp Q                 &kp W                 &kp E              &kp R                   &kp T                                 &kp C_AC_ZOOM_IN               &kp Y      &kp U                    &kp I              &kp O                  &kp P                          &kp MINUS
&td0     &HR_other LEFT_GUI A  &HR_other LEFT_ALT S  &HR_other LCTRL D  &HR_Shift LEFT_SHIFT F  &kp G                     &kp K_PREV  &kp K_PLAY_PAUSE   &kp K_NEXT  &kp H      &HR_Shift RIGHT_SHIFT J  &HR_other RCTRL K  &HR_other RIGHT_ALT L  &HR_other RIGHT_GUI SEMICOLON  &kp SQT
&sl 5    &kp Z                 &kp X                 &kp C              &kp V                   &kp B        &kp SPACE                &kp C_AC_ZOOM_OUT              &kp N      &kp M                    &kp COMMA          &kp DOT                &kp FSLH                       &kp EQUAL
                                                     &kp LEFT_ALT       &lt 1 BACKSPACE         &lt 4 SPACE                                                          &kp ENTER  &lt 2 TAB                &lt 3 K_MENU
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        Number {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                     &trans          &kp F11       &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SLASH     &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &kp F12       &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &kp PLUS
&trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans            &trans          &trans        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH     &kp EQUAL
                        &trans  &trans  &trans                                     &kp NUMBER_0  &trans        &kp PERIOD
            >;
        };

        Navigation {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans  &kp HOME   &kp UP    &kp END    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &kp LEFT   &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans          &trans  &kp PG_UP  &trans    &kp PG_DN  &trans  &trans
                        &trans  &trans  &trans                                    &trans  &trans     &trans
            >;
        };

        Mouse {
            bindings = <
&trans  &trans  &mkp RCLK  &trans  &mkp LCLK  &trans                    &trans          &trans  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans  &trans
&trans  &trans  &trans     &trans  &trans     &trans            &trans  &trans  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans     &trans  &trans     &trans  &trans            &trans          &trans  &msc SCRL_UP    &trans          &msc SCRL_DOWN   &trans  &trans
                           &trans  &trans     &trans                                    &trans  &trans          &trans
            >;
        };

        Symbols {
            bindings = <
&kp GRAVE  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                    &trans          &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)     &trans
&trans     &trans      &trans      &trans      &trans      &trans                &trans  &trans  &trans  &trans      &trans      &trans      &trans      &trans         &trans
&trans     &trans      &trans      &trans      &trans      &trans      &trans            &trans          &trans      &trans      &trans      &trans      &kp BACKSLASH  &trans
                                   &trans      &trans      &trans                                        &trans      &trans      &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp Q  &kp W  &kp E   &kp R   &kp T                        &trans          &kp Y      &kp U   &kp I      &kp O    &kp P     &kp MINUS
&kp TAB  &kp A  &kp S  &kp D   &kp F   &kp G                &trans  &trans  &trans  &kp H      &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&sl 0    &kp Z  &kp X  &kp C   &kp V   &kp B      &trans            &trans          &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp EQUAL
                       &trans  &trans  &kp SPACE                                    &kp ENTER  &trans  &trans
            >;
        };

        Nav_other {
            display-name = "Navigation";
            bindings = <
&trans  &kp EXCL      &kp AT        &kp HASH   &kp DLLR   &kp PRCNT                            &mmv MOVE_UP                     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &bt BT_CLR    &mkp LCLK     &mkp MCLK  &mkp RCLK  &mkp MB4             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &out OUT_USB  &out OUT_BLE  &none      &none      &mkp MB5   &trans                    &mmv MOVE_DOWN                   &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                    &trans     &trans     &kp SPACE                                                             &kp RET    &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            display-name = "Mouse";
            bindings = <
&studio_unlock  &kp F1      &kp F2     &kp F3       &kp F4     &kp F5                                  &mmv MOVE_UP                     &kp F6       &kp F7     &kp F8       &kp F9      &kp F10          &kp F11
&trans          &trans      &mkp LCLK  &mkp MCLK    &mkp RCLK  &mkp MB4                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &bootloader  &mkp LCLK  &mkp MCLK    &mkp RCLK   &kp PRINTSCREEN  &kp F12
&trans          &sys_reset  &trans     &bootloader  &trans     &mkp MB5  &kp C_MUTE                    &mmv MOVE_DOWN                   &trans       &trans     &bootloader  &sys_reset  &kp SCROLLLOCK   &kp PAUSE_BREAK
                                       &trans       &trans     &trans                                                                   &trans       &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
